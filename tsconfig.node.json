{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "composite": true
  },
  "include": [
    "main-process/**/*.ts",
    "src/utils/investmentHoldings.ts",
    "src/utils/investmentReturns.ts",
    "src/types/agentSync.ts",
    "main-process/investment-cloud-key.ts",
    "electron-vite.config.mjs",
    "src/database-addcategory.test.ts",
    "src/database-deletecategory.test.ts",
    "src/database-switchuser.test.ts",
    "src/database-agent-sync.test.ts"
  ]
}
