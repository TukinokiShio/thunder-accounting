  keys_retrieved: [PRODUCT.md, DESIGN.md, docs/login-demos/round-3/round-3.css]
anti_evasion_log:
  - id: restart-001
    finding: 旧状态声明 USER_ACCEPT_FINAL，但验收状态 pending 且无 evidence_paths
    action: 回流 TASK_CLASSIFY，清空旧终态语义，不继承旧分数或角色回执
