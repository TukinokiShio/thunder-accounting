subagent_usage:
  degradation: >
    round2 EXEC 降级：Worker-1(Knuth)/Worker-2(Lovelace) 经 Agent 工具 spawn 成功（in-process backend）但
    14+ 分钟零文件产出，team-lead 两次 SendMessage 唤醒无响应，判定 in-process 子代理通道不可用；
    按 sacw §0.1 显式降级条款由主 Agent 按契约（contracts/orchestration/defect-round2-worker{1,2}.json）
    直写，改动范围严格限于契约 required_changes；REVIEW 不降级，改派新 Reviewer 子代理或交用户人工审查
  rounds: 4
  subagent_count: 10
  roles:
    - role: Explore
      agent: Hypatia
      status: completed
      scope: tech-stack、UI 入口、构建/打包链、清理候选的只读扫描
    - role: Worker
      agent: Darwin
      status: completed
      scope: dialog accessibility/focus and Settings account route
    - role: Worker
      agent: Beauvoir
      status: completed
      scope: global token/focus/text selection CSS
    - role: Worker
      agent: Volta
      status: completed
      scope: Stats/Bills/Profile UI states and semantic colors
    - role: Worker
      agent: Fermat
      status: completed
      scope: deploy output target
    - role: Worker
      agent: Pascal
      status: completed
      scope: Inno fixed installation target
    - role: Test
      agent: Maxwell
      status: completed
      scope: Vitest full suite
    - role: Reviewer
      agent: Heisenberg
      status: interrupted
      scope: targeted final diff review; stopped after timeout
    - role: Worker
      agent: Knuth
      status: failed
      scope: defect-round2-worker1 database rowid timing fix + regression test（spawn 后零产出，降级主 Agent 代行）
    - role: Worker
      agent: Lovelace
      status: failed
      scope: defect-round2-worker2 category manager focus/btn UI fix（spawn 后零产出，降级主 Agent 代行）
  spec_id: [sacw-agent-specs/explore]
  depth: 2
  modes: [multi_agent_v1]
  last_used: 2
orchestration_form: 多 Agent 编排
