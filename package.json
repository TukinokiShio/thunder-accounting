{
  "name": "thunder-accounting",
  "version": "2.0.3",
  "description": "雷霆记账 - 轻量级个人日常记账工具",
  "main": "./app-out/main/main.js",
  "author": "TukinokiShio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win",
    "verify:release": "node scripts/verify-release.cjs",
    "verify:modal-scope": "node scripts/verify-modal-scope.cjs",
    "verify:android-layout": "node scripts/verify-android-layout.cjs",
    "verify:profile-mobile": "node scripts/verify-profile-mobile.cjs",
    "verify:desktop-parity": "node scripts/verify-desktop-parity.cjs",
    "verify:recurring-dialog": "node scripts/verify-recurring-dialog.cjs",
    "verify:cloud-deletion": "node scripts/verify-cloud-deletion.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "deploy": "node scripts/deploy.cjs",
    "migrate:accounts": "node scripts/migrate-account-ids.cjs",
    "migrate:accounts:dry": "node scripts/migrate-account-ids.cjs --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json",
    "prebuild:android": "node scripts/verify-android-layout.cjs",
    "build:android": "vite build --config vite.mobile.config.mjs && cap sync android",
    "android:accept": "node scripts/android-acceptance.cjs"
  },
  "dependencies": {
    "@cloudbase/cloudbase-mcp": "^2.24.1",
    "@cloudbase/manager-node": "^5.6.4",
    "@cloudbase/node-sdk": "^3.18.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
    "recharts": "^2.15.0",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vitest": {
      "vite": "^6.0.0"
    }
  },
  "build": {
    "appId": "com.thunder.accounting",
    "productName": "雷霆记账",
    "executableName": "雷霆记账",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "app-out/**/*",
      "package.json"
    ],
    "disableDefaultIgnoredFiles": true,
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "unicode": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
